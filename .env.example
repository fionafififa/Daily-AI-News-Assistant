# demo = labelled offline fixtures; live = real model + RSS, never falls back to demo
APP_MODE=demo
OPENAI_API_KEY=
# Any Chat Completions-compatible endpoint with function calling can be used.
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4.1-mini
DATA_DIR=./data
# Empty uses local SQLite; setting PostgreSQL switches all application data together.
# Example: postgresql+psycopg://ai_news:ai_news_dev@127.0.0.1:5432/ai_news
DATABASE_URL=
SCHEDULER_ENABLED=true
AGENT_TIMEOUT_SECONDS=180
MAX_TOOL_CALLS=24
SUMMARY_REVIEW_ENABLED=true
SUMMARY_REVIEW_SOURCE_CHARS=5000
WORKING_CONTEXT_ENABLED=true
PREFILTER_ENABLED=true

# Inbox push is always available. SMTP is optional; select email in the UI.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_SECURITY=starttls

# bash tool supports a deliberately small read-only command subset.
# On Windows set this to Git Bash, not the legacy Windows WSL launcher.
BASH_EXECUTABLE=

